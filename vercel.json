{
  "buildCommand": "sh _infra/build_v6.sh",
  "outputDirectory": "_infra/dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|svg|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
